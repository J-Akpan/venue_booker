NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0                # number of reverse proxies in front of the app (1 behind nginx/ingress)
CORS_ORIGINS=http://localhost:3000

# Database
DB_NAME=venue_booker
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_REPLICA_HOST=             # optional read replica
DB_POOL_MAX=10
DB_SYNC=true                 # create missing tables on boot (dev). In production run `npm run db:init` once.

# Redis (optional: cache, distributed rate limits, durable job queue)
REDIS_URL=redis://localhost:6379

# Auth: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://localhost:3000/payment/success
CHECKOUT_CANCEL_URL=http://localhost:3000/payment/cancel
BOOKING_HOLD_MINUTES=15

# Email
EMAIL_USER=
EMAIL_PASS=

# Observability
METRICS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g. http://otel-collector:4318 to enable tracing
