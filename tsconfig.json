{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "tests"]
}
